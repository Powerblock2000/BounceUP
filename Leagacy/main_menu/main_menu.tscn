shader_parameter/angle_half_width = 0.6410000304475
shader_parameter/angle_softness = 0.02
shader_parameter/inner_radius = 0.70000003325
shader_parameter/outer_radius = 0.9
shader_parameter/radius_softness = 0.02
shader_parameter/base_color = Color(1, 1, 1, 0)
shader_parameter/line_color = Color(1, 1, 1, 1)

