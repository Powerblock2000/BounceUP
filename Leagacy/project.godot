; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bounce Up"
run/main_scene="uid://dt2psio014blo"
config/features=PackedStringArray("4.8", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://ck7xbo0nonbnw"

[autoload]

PBFuncs="*res://addons/powerblockpluginhelper/pb_func.gd"
ItemAccessor="*res://addons/masterinv/Autoloads/ItemAccessor.gd"
TooltipManager="*res://addons/bettertooltips/UI/better_tooltips.tscn"
IntersceneSaveManager="*uid://c4hik6t6kdfql"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file="/home/linuxguy/BounceUp/BounceUP/Leagacy/render/cover.png"

[editor_plugins]

enabled=PackedStringArray("res://addons/bettertooltips/plugin.cfg", "res://addons/masterinv/plugin.cfg", "res://addons/powerblockpluginhelper/plugin.cfg")

[gui]

common/auto_focus_strategy=1

